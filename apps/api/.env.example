CREATOR_OS_ENVIRONMENT=development
# Local development runs on a file-backed SQLite database (apps/api/creator_os_local.db)
# when DATABASE_URL is not set. Tables and the development dataset are provisioned
# automatically on API startup. Set DATABASE_URL to a PostgreSQL URL to use Postgres.
# DATABASE_URL=postgresql+psycopg://creator_os:replace-with-a-local-development-password@localhost:5432/creator_os
CORS_ORIGINS=http://localhost:3000
LOCAL_STORAGE_PATH=storage
