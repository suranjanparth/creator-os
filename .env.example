POSTGRES_DB=creator_os
POSTGRES_USER=creator_os
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://creator_os:replace-with-a-local-development-password@db:5432/creator_os

# Instagram/Meta Graph API integration (future): required to authorize a real
# creator account and ingest live content. Read from the API environment only;
# never expose any of these to the browser. Permissions needed on the Meta app:
# instagram_business_basic (read published posts/metrics) for the authorized user.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/auth/instagram/callback
# INSTAGRAM_ACCESS_TOKEN=  # short-lived or long-lived token obtained after OAuth
# INSTAGRAM_USER_ID=       # Instagram Business Account id returned by the token exchange
